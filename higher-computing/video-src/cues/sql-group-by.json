 "lines": [
  {
   "scene": "title",
   "si": 0,
   "li": 0,
   "voice": "H",
   "start": 1.2,
   "end": 5.284,
   "cap": "Muster the cadets! I want a headcount for every squadron."
  },
  {
   "scene": "table",
   "si": 1,
   "li": 0,
   "voice": "A",
   "start": 6.184,
   "end": 16.221,
   "cap": "The Cadet table: 12 rows. COUNT(*) alone gives 12. The Captain wants one count for each squadron."
  },
  {
   "scene": "group",
   "si": 2,
   "li": 0,
   "voice": "A",
   "start": 17.121,
   "end": 23.6,
   "cap": "GROUP BY squadronNo gathers rows with the same squadron number. Four squadrons, four groups."
  },
  {
   "scene": "collapse",
   "si": 3,
   "li": 0,
   "voice": "A",
   "start": 24.5,
   "end": 31.003,
   "cap": "The aggregate runs once per group. Each group collapses into one row with its count."
  },
  {
   "scene": "order",
   "si": 4,
   "li": 0,
   "voice": "A",
   "start": 31.903,
   "end": 38.341,
   "cap": "Add an alias for a readable heading, then ORDER BY COUNT(*) ASC for the smallest first."
  },
  {
   "scene": "order",
   "si": 4,
   "li": 1,
   "voice": "A",
   "start": 38.791,
   "end": 42.023,
   "cap": "Remember: GROUP BY always comes before ORDER BY."
  },
  {
   "scene": "traps",
   "si": 5,
   "li": 0,
   "voice": "H",
   "start": 42.923,
   "end": 45.368,
   "cap": "Any traps for the unwary, Lieutenant?"
  },
  {
   "scene": "traps",
   "si": 5,
   "li": 1,
   "voice": "A",
   "start": 45.818,
   "end": 53.411,
   "cap": "Two. An aggregate can't go in a WHERE clause: work it out in one query and use it in a second."
  },
  {
   "scene": "traps",
   "si": 5,
   "li": 2,
   "voice": "A",
   "start": 53.861,
   "end": 58.354,
   "cap": "And never mix a plain field with an aggregate unless you GROUP BY that field."
  },
  {
   "scene": "outro",
   "si": 6,
   "li": 0,
   "voice": "A",
   "start": 59.254,
   "end": 62.644,
   "cap": "Group, then aggregate, then order. Dismissed!"
  }
 ],
 "duration": 65.544
}