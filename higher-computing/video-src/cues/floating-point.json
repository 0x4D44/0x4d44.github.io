 "lines": [
  {
   "scene": "title",
   "si": 0,
   "li": 0,
   "voice": "A",
   "start": 1.2,
   "end": 12.666,
   "cap": "Two's complement only stores whole numbers. A navigator needs fractions, like latitude 56.1875°. For real numbers, computers use floating point."
  },
  {
   "scene": "denary",
   "si": 1,
   "li": 0,
   "voice": "A",
   "start": 13.566,
   "end": 18.273,
   "cap": "The idea in denary: move the point to the front, and count the hops."
  },
  {
   "scene": "denary",
   "si": 1,
   "li": 1,
   "voice": "A",
   "start": 18.723,
   "end": 28.126,
   "cap": "Five hops left: 34 006.8 = 0.340068 × 10⁵"
  },
  {
   "scene": "binary",
   "si": 2,
   "li": 0,
   "voice": "A",
   "start": 29.026,
   "end": 38.251,
   "cap": "Computers do the same in binary: 66.625 = 1000010.101"
  },
  {
   "scene": "binary",
   "si": 2,
   "li": 1,
   "voice": "A",
   "start": 38.701,
   "end": 45.431,
   "cap": "Hop the point left until it sits just before the first 1. Seven hops, so the exponent is 7."
  },
  {
   "scene": "fields",
   "si": 3,
   "li": 0,
   "voice": "A",
   "start": 46.331,
   "end": 51.408,
   "cap": "Store three parts. A sign bit: 0 for positive, 1 for negative."
  },
  {
   "scene": "fields",
   "si": 3,
   "li": 1,
   "voice": "A",
   "start": 51.858,
   "end": 56.528,
   "cap": "The mantissa: the digits after the point, padded with zeros to 15 bits."
  },
  {
   "scene": "fields",
   "si": 3,
   "li": 2,
   "voice": "A",
   "start": 56.978,
   "end": 61.152,
   "cap": "And the exponent: 7, stored in 8-bit two's complement."
  },
  {
   "scene": "small",
   "si": 4,
   "li": 0,
   "voice": "H",
   "start": 62.052,
   "end": 64.704,
   "cap": "And what about a tiny number, Lieutenant?"
  },
  {
   "scene": "small",
   "si": 4,
   "li": 1,
   "voice": "A",
   "start": 65.154,
   "end": 77.816,
   "cap": "Then the point hops right and the exponent is negative. 0.0010101 needs two hops right: −2 = 1111 1110."
  },
  {
   "scene": "tradeoff",
   "si": 5,
   "li": 0,
   "voice": "A",
   "start": 78.716,
   "end": 85.957,
   "cap": "The total number of bits is fixed. More bits for the mantissa: more precision."
  },
  {
   "scene": "tradeoff",
   "si": 5,
   "li": 1,
   "voice": "A",
   "start": 86.407,
   "end": 93.009,
   "cap": "More bits for the exponent: more range. You can't have both."
  },
  {
   "scene": "outro",
   "si": 6,
   "li": 0,
   "voice": "A",
   "start": 93.909,
   "end": 99.795,
   "cap": "Mantissa → precision. Exponent → range. Use those exact words in the exam."
  }
 ],
 "duration": 102.695
}