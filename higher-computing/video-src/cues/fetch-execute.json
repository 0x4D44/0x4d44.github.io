 "lines": [
  {
   "scene": "title",
   "si": 0,
   "li": 0,
   "voice": "H",
   "start": 1.2,
   "end": 9.478,
   "cap": "Beat to quarters! Every gun crew aboard follows the same drill, over and over. So does every processor."
  },
  {
   "scene": "parts",
   "si": 1,
   "li": 0,
   "voice": "A",
   "start": 10.378,
   "end": 20.725,
   "cap": "The processor and main memory, joined by three buses: the address bus, the data bus and the control bus."
  },
  {
   "scene": "step1",
   "si": 2,
   "li": 0,
   "voice": "A",
   "start": 21.625,
   "end": 26.674,
   "cap": "Step 1: the processor sets up the address bus with the address of the instruction."
  },
  {
   "scene": "step1",
   "si": 2,
   "li": 1,
   "voice": "H",
   "start": 27.124,
   "end": 28.367,
   "cap": "Locker 04!"
  },
  {
   "scene": "step2",
   "si": 3,
   "li": 0,
   "voice": "A",
   "start": 29.267,
   "end": 35.274,
   "cap": "Step 2: the processor activates the read line on the control bus."
  },
  {
   "scene": "step3",
   "si": 4,
   "li": 0,
   "voice": "A",
   "start": 36.174,
   "end": 49.915,
   "cap": "Step 3: the instruction travels along the data bus into the instruction register, and the program counter steps on to 05."
  },
  {
   "scene": "step4",
   "si": 5,
   "li": 0,
   "voice": "A",
   "start": 50.815,
   "end": 55.147,
   "cap": "Step 4: the instruction is decoded and executed."
  },
  {
   "scene": "step4",
   "si": 5,
   "li": 1,
   "voice": "H",
   "start": 55.597,
   "end": 56.123,
   "cap": "Fire!"
  },
  {
   "scene": "perf",
   "si": 6,
   "li": 0,
   "voice": "A",
   "start": 57.023,
   "end": 61.745,
   "cap": "To speed up the drill: more cores, more crews firing at once."
  },
  {
   "scene": "perf",
   "si": 6,
   "li": 1,
   "voice": "A",
   "start": 62.195,
   "end": 72.533,
   "cap": "A wider data bus: more bits per trip. More cache: fewer slow trips to main memory."
  },
  {
   "scene": "perf",
   "si": 6,
   "li": 2,
   "voice": "A",
   "start": 72.983,
   "end": 77.532,
   "cap": "A higher clock speed: a faster drumbeat, more cycles per second."
  },
  {
   "scene": "outro",
   "si": 7,
   "li": 0,
   "voice": "H",
   "start": 78.432,
   "end": 85.843,
   "cap": "Address bus. Read line. Data bus. Decode and execute. Learn it like your drill, cadets."
  }
 ],
