 "lines": [
  {
   "scene": "title",
   "si": 0,
   "li": 0,
   "voice": "A",
   "start": 1.2,
   "end": 9.06,
   "cap": "Welcome aboard, cadets. Today: how a computer stores negative numbers, using nothing but eight redstone lamps."
  },
  {
   "scene": "positive",
   "si": 1,
   "li": 0,
   "voice": "A",
   "start": 9.96,
   "end": 19.071,
   "cap": "At National 5, every lamp had a positive place value: 128, 64, 32 … down to 1."
  },
  {
   "scene": "positive",
   "si": 1,
   "li": 1,
   "voice": "A",
   "start": 19.521,
   "end": 28.209,
   "cap": "Light the right lamps and add their values: 32 + 8 + 4 + 1 = 45."
  },
  {
   "scene": "negative",
   "si": 2,
   "li": 0,
   "voice": "H",
   "start": 29.109,
   "end": 32.664,
   "cap": "But there's no such thing as a negative lamp, Lieutenant!"
  },
  {
   "scene": "negative",
   "si": 2,
   "li": 1,
   "voice": "A",
   "start": 33.114,
   "end": 42.629,
   "cap": "Then we make one, Captain. In two's complement, the leftmost lamp is worth −128. Every other lamp stays positive."
  },
  {
   "scene": "readneg",
   "si": 3,
   "li": 0,
   "voice": "A",
   "start": 43.529,
   "end": 53.88,
   "cap": "So 1101 0011 means −128 + 64 + 16 + 2 + 1 …"
  },
  {
   "scene": "readneg",
   "si": 3,
   "li": 1,
   "voice": "A",
   "start": 54.33,
   "end": 59.595,
   "cap": "… = −45. If the leftmost lamp is lit, the number is negative."
  },
  {
   "scene": "flip",
   "si": 4,
   "li": 0,
   "voice": "A",
   "start": 60.495,
   "end": 64.797,
   "cap": "To turn −45 into binary, use flip and add one."
  },
  {
   "scene": "flip",
   "si": 4,
   "li": 1,
   "voice": "A",
   "start": 65.247,
   "end": 71.013,
   "cap": "First write +45:  0010 1101"
  },
  {
   "scene": "flip",
   "si": 4,
   "li": 2,
   "voice": "A",
   "start": 71.463,
   "end": 77.267,
   "cap": "Flip every bit:  1101 0010"
  },
  {
   "scene": "flip",
   "si": 4,
   "li": 3,
   "voice": "A",
   "start": 77.717,
   "end": 85.46,
   "cap": "Add 1:  1101 0011. Check with the place values: it works."
  },
  {
   "scene": "range",
   "si": 5,
   "li": 0,
   "voice": "H",
   "start": 86.36,
   "end": 88.437,
   "cap": "And how far can eight lamps count?"
  },
  {
   "scene": "range",
   "si": 5,
   "li": 1,
   "voice": "A",
   "start": 88.887,
   "end": 97.919,
   "cap": "From −128 (only the leftmost lamp lit) up to 127 (every lamp except that one)."
  },
  {
   "scene": "range",
   "si": 5,
   "li": 2,
   "voice": "A",
   "start": 98.369,
   "end": 105.394,
   "cap": "For n bits: −2ⁿ⁻¹ to 2ⁿ⁻¹ − 1."
  },
  {
   "scene": "outro",
   "si": 6,
   "li": 0,
   "voice": "A",
   "start": 106.294,
   "end": 112.117,
   "cap": "Leftmost lamp negative. Flip and add one. Always check your answer. Dismissed!"
  }
 ],
 "duration": 115.017
}