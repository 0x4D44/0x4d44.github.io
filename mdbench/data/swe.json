{
 "schema": "mdbench-site/1",
 "suite": "swe",
 "title": "Software development",
 "description": "Ten real engineering problems, two per lane: design, code, test, review and fix. Judge-scored 0-100.",
 "sample": false,
 "group": {
  "key": "group",
  "label": "Lane",
  "values": [
   {
    "id": "DES",
    "label": "Design",
    "description": "Given a problem and the code as it stood, write a design doc."
   },
   {
    "id": "COD",
    "label": "Code",
    "description": "Given an approved design, implement it with tests."
   },
   {
    "id": "TST",
    "label": "Test",
    "description": "Given a working implementation, write the test suite."
   },
   {
    "id": "REV",
    "label": "Review",
    "description": "Given a change later found to be faulty, review it."
   },
   {
    "id": "FIX",
    "label": "Fix",
    "description": "Given a symptom, find the root cause and fix it with a regression test."
   }
  ]
 },
 "metrics": [
  {
   "id": "score",
   "label": "Judge score",
   "role": "headline",
   "type": "number",
   "unit": "points",
   "higher_is_better": true,
   "min": 0,
   "max": 100,
   "format": {
    "decimals": 1
   },
   "description": "Mean of six blind judges, 0-100 (may include up to +10 novelty bonus)."
  },
  {
   "id": "rubric",
   "label": "Rubric",
   "type": "number",
   "unit": "points",
   "higher_is_better": true,
   "min": 0,
   "max": 100,
   "format": {
    "decimals": 1
   },
   "description": "Structured rubric score from the two scorers."
  },
  {
   "id": "score_claude",
   "label": "Claude judges",
   "type": "number",
   "unit": "points",
   "higher_is_better": true,
   "min": 0,
   "max": 100,
   "format": {
    "decimals": 1
   },
   "description": "Mean of the three Claude Opus 5.5 judges."
  },
  {
   "id": "score_gpt",
   "label": "GPT judges",
   "type": "number",
   "unit": "points",
   "higher_is_better": true,
   "min": 0,
   "max": 100,
   "format": {
    "decimals": 1
   },
   "description": "Mean of the three GPT-6 Astra judges."
  },
  {
   "id": "judge_sd",
   "label": "Judge spread",
   "type": "number",
   "unit": "points",
   "higher_is_better": false,
   "format": {
    "decimals": 1,
    "prefix": "±"
   },
   "description": "Standard deviation of the six judges' scores."
  },
  {
   "id": "bonus",
   "label": "Bonus",
   "type": "number",
   "unit": "points",
   "higher_is_better": true,
   "format": {
    "decimals": 1,
    "prefix": "+"
   },
   "description": "Mean novelty bonus across judges."
  },
  {
   "id": "mean_rank",
   "label": "Mean rank",
   "type": "number",
   "unit": "rank",
   "higher_is_better": false,
   "format": {
    "decimals": 1
   },
   "description": "Mean within-exercise rank given by the judges (1 = best)."
  },
  {
   "id": "cost_usd",
   "label": "Cost",
   "role": "cost",
   "type": "number",
   "unit": "USD",
   "higher_is_better": false,
   "format": {
    "decimals": 2,
    "prefix": "$"
   },
   "description": "List-price cost of the run (reported or estimated; see seat)."
  },
  {
   "id": "wall_min",
   "label": "Wall time",
   "role": "time",
   "type": "number",
   "unit": "minutes",
   "higher_is_better": false,
   "format": {
    "decimals": 0,
    "suffix": " min"
   },
   "description": "Wall-clock time of the run."
  },
  {
   "id": "gates_ok",
   "label": "All gates",
   "role": "gate",
   "type": "bool",
   "higher_is_better": true,
   "description": "Every mechanical gate passed (build, lints, hidden tests, parity, speed...)."
  },
  {
   "id": "builds",
   "label": "Builds",
   "type": "bool",
   "higher_is_better": true,
   "description": "The output applied and built."
  },
  {
   "id": "hidden_pass",
   "label": "Hidden tests",
   "type": "number",
   "unit": "fraction",
   "higher_is_better": true,
   "min": 0,
   "max": 1,
   "format": {
    "decimals": 0,
    "scale": 100,
    "suffix": "%"
   },
   "description": "Share of hidden tests passed (code exercises)."
  },
  {
   "id": "parity_ok",
   "label": "Parity",
   "type": "bool",
   "higher_is_better": true,
   "description": "Differential parity against the interpreter held (recompiler exercises)."
  },
  {
   "id": "speed_ok",
   "label": "Speed gate",
   "type": "bool",
   "higher_is_better": true,
   "description": "The timed benchmark showed a gain separated from noise (performance exercises)."
  },
  {
   "id": "speed_of_ref",
   "label": "Speed vs reference",
   "type": "number",
   "unit": "fraction",
   "higher_is_better": true,
   "format": {
    "decimals": 0,
    "scale": 100,
    "suffix": "%"
   },
   "description": "Speed gain as a share of the historical reference fix's gain (performance exercises)."
  }
 ],
 "tasks": [
  {
   "id": "DES-01",
   "group": "DES",
   "title": "Why is the JIT slower?",
   "description": "Diagnose why an early dynamic recompiler in a PC emulator ran slower than the interpreter it replaced, and design the way out.",
   "tags": [
    "perf"
   ]
  },
  {
   "id": "DES-02",
   "group": "DES",
   "title": "Kernel demand paging",
   "description": "Design paged and non-paged memory for a hobby operating-system kernel, starting from what the code can support today.",
   "tags": []
  },
  {
   "id": "COD-01",
   "group": "COD",
   "title": "Recompiler fast path",
   "description": "Implement a planned optimisation in an AArch64 dynamic recompiler from its approved design. Hidden tests, differential parity and a speed gate.",
   "tags": [
    "perf"
   ],
   "note": "Speed was timed on two different days on a shared machine; the speed gate (gain separated from noise) holds, but speed-of-reference fractions from different days are not strictly comparable."
  },
  {
   "id": "COD-02",
   "group": "COD",
   "title": "Kernel swap file",
   "description": "Implement a kernel's swap-file component from its approved design. Graded by hidden tests.",
   "tags": []
  },
  {
   "id": "TST-01",
   "group": "TST",
   "title": "Keyboard and interrupts",
   "description": "Write tests for an emulated keyboard controller and its interrupt path. Graded by how many planted bugs the tests catch.",
   "tags": []
  },
  {
   "id": "TST-02",
   "group": "TST",
   "title": "Self-modifying code",
   "description": "Write tests for self-modifying-code invalidation in a dynamic recompiler. Graded by mutant kill rate.",
   "tags": [
    "perf"
   ]
  },
  {
   "id": "REV-01",
   "group": "REV",
   "title": "Review a speed-up",
   "description": "Review an interpreter speed-up that, it later turned out, broke a game. Graded on recall of the known defects.",
   "tags": [
    "perf"
   ]
  },
  {
   "id": "REV-02",
   "group": "REV",
   "title": "Review a recompiler change",
   "description": "Review a recompiler change that introduced memory corruption. Graded on known-defect recall and precision.",
   "tags": []
  },
  {
   "id": "FIX-01",
   "group": "FIX",
   "title": "Missing score digits",
   "description": "A DOS game shows no score digits. From the symptom report, find the root cause and fix it with a regression test.",
   "tags": [],
   "note": "Most seats fail the hidden display-register test, so All gates shows fail for them; the judge score reflects how much of the fix each seat got right."
  },
  {
   "id": "FIX-02",
   "group": "FIX",
   "title": "Slower than the reference",
   "description": "The recompiler is slower than a reference emulator on a game benchmark. Find out why and fix it. Speed-gated.",
   "tags": [
    "perf"
   ]
  }
 ],
