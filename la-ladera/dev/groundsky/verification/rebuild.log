from pathlib import Path
import datetime
import hashlib
import json
import shlex
import sys

root = Path('/workspace/scratch/32e9192f94b1/groundsky-repo/la-ladera')
report_path = root / 'dev/groundsky/verification/rebuild.json'
log_path = root / 'dev/groundsky/verification/rebuild.log'
report = json.loads(report_path.read_text())
if not report['ok']:
    raise SystemExit('The clean rebuild must pass before the final catalogue-pin check')
catalogue_path = root / 'tools/groundsky.catalog.json'
catalogue_bytes = catalogue_path.read_bytes()
catalogue = json.loads(catalogue_bytes)
checks = []
for record in catalogue['files']:
    file_bytes = (root / record['path']).read_bytes()
    digest = hashlib.sha256(file_bytes).hexdigest()
    checks.append({
        'path': record['path'], 'format': record['format'],
        'catalogueBytes': record['bytes'], 'actualBytes': len(file_bytes),
        'catalogueSha256': record['sha256'], 'actualSha256': digest,
        'matches': record['bytes'] == len(file_bytes) and record['sha256'] == digest,
    })
failed = [c['path'] for c in checks if not c['matches']]
counts = {kind: sum(c['format'] == kind for c in checks) for kind in ['png', 'ktx2']}
result = {
    'ok': not failed and counts == {'png': 122, 'ktx2': 122},
    'utc': datetime.datetime.now(datetime.timezone.utc).isoformat(),
    'command': [sys.executable, str(Path(__file__).resolve())],
    'cataloguePath': 'tools/groundsky.catalog.json',
    'catalogueSha256': hashlib.sha256(catalogue_bytes).hexdigest(),
    'fileCount': len(checks), 'counts': counts,
    'matchingCount': sum(c['matches'] for c in checks), 'mismatchedPaths': failed,
    'actualBytes': sum(c['actualBytes'] for c in checks), 'files': checks,
}
report['cataloguePinCheck'] = result
report['ok'] = report['ok'] and result['ok']
report_path.write_text(json.dumps(report, indent=2) + '\n')
summary = {k: v for k, v in result.items() if k != 'files'}
with log_path.open('a') as log:
    log.write('\nFinal catalogue pin verification, after final packaging\n')
    log.write('$ ' + shlex.join(result['command']) + '\n')
    log.write('Driver source follows, so the exact file-byte/hash check can be reproduced:\n')
    log.write(Path(__file__).read_text() + '\n')
    for entry in checks:
        log.write(('MATCH ' if entry['matches'] else 'MISMATCH ') + entry['path'] + '\n')
        log.write(f'  catalogue {entry["catalogueSha256"]} ({entry["catalogueBytes"]} bytes)\n')
        log.write(f'  actual    {entry["actualSha256"]} ({entry["actualBytes"]} bytes)\n')
    log.write('FINAL CATALOGUE CHECK\n' + json.dumps(summary, indent=2) + '\n')
    log.write('\nClean-tree rebuild driver source, for the earlier logged rebuild commands:\n')
    log.write(Path('/workspace/scratch/32e9192f94b1/groundsky-rebuild-check.py').read_text() + '\n')
print(json.dumps(summary, indent=2))
sys.exit(0 if result['ok'] else 1)

