from __future__ import annotations

import datetime
import hashlib
import importlib.metadata
import json
import os
from pathlib import Path
import shlex
import shutil
import subprocess
import sys
import tempfile
import time


REPO = Path('/workspace/scratch/32e9192f94b1/groundsky-repo')
ROOT = REPO / 'la-ladera'
OUT = ROOT / 'dev/groundsky/verification'
OUT.mkdir(parents=True, exist_ok=True)
LOG = OUT / 'rebuild.log'
REPORT = OUT / 'rebuild.json'
scratch = Path(tempfile.mkdtemp(prefix='groundsky-rebuild-', dir='/workspace/scratch/32e9192f94b1'))
mini = scratch / 'la-ladera'
(mini / 'tools').mkdir(parents=True)
env = dict(os.environ)
env.update(OMP_NUM_THREADS='2', OPENBLAS_NUM_THREADS='2', MKL_NUM_THREADS='2',
           NUMEXPR_NUM_THREADS='2', PYTHONDONTWRITEBYTECODE='1')
try:
    os.nice(max(0, 19 - os.getpriority(os.PRIO_PROCESS, 0)))
except (AttributeError, OSError):
    pass


def digest(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def write_log(text):
    with LOG.open('a', encoding='utf-8') as log:
        log.write(text + '\n')


start = time.monotonic()
now = datetime.datetime.now(datetime.timezone.utc).isoformat()
LOG.write_text('Groundsky clean-tree deterministic PNG rebuild\n'
               f'UTC {now}\nRepository: {REPO}\nFresh tree: {scratch}\n'
               '$ ' + shlex.join([sys.executable, str(Path(__file__).resolve())]) + '\n', encoding='utf-8')
versions = {name: importlib.metadata.version(name) for name in ['numpy', 'Pillow', 'scipy']}
write_log('Python: ' + sys.version.replace('\n', ' '))
write_log('Dependencies: ' + json.dumps(versions, sort_keys=True))
write_log('Environment: OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2 NUMEXPR_NUM_THREADS=2 PYTHONDONTWRITEBYTECODE=1')
write_log('Process nice value: ' + str(os.getpriority(os.PRIO_PROCESS, 0)))

sources = []
for name in ['groundsky_ground.py', 'groundsky_sky.py']:
    original = ROOT / 'tools' / name
    copied = mini / 'tools' / name
    shutil.copyfile(original, copied)
    pin = {'path': 'tools/' + name, 'sha256': digest(original), 'copiedSha256': digest(copied),
           'bytes': original.stat().st_size}
    assert pin['sha256'] == pin['copiedSha256']
    sources.append(pin)
    write_log(f'COPY {original} -> {copied}\nSHA256 {pin["sha256"]}')

expected = []
for name in ['ground-metadata.json', 'sky-metadata.json']:
    obj = json.loads((ROOT / 'dev/groundsky' / name).read_text())
    for entry in obj['files']:
        source = ROOT / entry['path']
        expected.append({'path': entry['path'], 'expectedSha256': digest(source),
                         'expectedBytes': source.stat().st_size})
assert len(expected) == 122 and len({r['path'] for r in expected}) == 122
write_log('Snapshot: 122 distinct existing intended master PNGs')

commands = []
failure = None
for name in ['groundsky_ground.py', 'groundsky_sky.py']:
    command = [sys.executable, str(mini / 'tools' / name)]
    write_log('\n$ ' + shlex.join(command))
    print('RUN ' + name, flush=True)
    then = time.monotonic()
    result = subprocess.run(command, cwd=scratch, env=env, text=True, capture_output=True,
                            creationflags=getattr(subprocess, 'CREATE_NO_WINDOW', 0))
    elapsed = round(time.monotonic() - then, 3)
    write_log(result.stdout.rstrip())
    if result.stderr:
        write_log('STDERR:\n' + result.stderr.rstrip())
    write_log(f'[exit {result.returncode}; seconds {elapsed}]')
    commands.append({'argv': command, 'cwd': str(scratch), 'exitCode': result.returncode, 'elapsedSeconds': elapsed})
    if result.returncode:
        failure = f'{name} failed with exit {result.returncode}'
        break

results = []
missing = []
drift = []
original_changes = []
for entry in sorted(expected, key=lambda item: item['path']):
    fresh = mini / entry['path']
    actual = ROOT / entry['path']
    entry['originalStillMatchesSnapshot'] = digest(actual) == entry['expectedSha256']
    if not entry['originalStillMatchesSnapshot']:
        original_changes.append(entry['path'])
    if not fresh.exists():
        entry.update(present=False, matches=False)
        missing.append(entry['path'])
        write_log('MISSING ' + entry['path'])
    else:
        entry.update(present=True, actualSha256=digest(fresh), actualBytes=fresh.stat().st_size)
        entry['matches'] = (entry['actualSha256'] == entry['expectedSha256'] and entry['actualBytes'] == entry['expectedBytes'])
        if not entry['matches']:
            drift.append(entry['path'])
        write_log(('MATCH ' if entry['matches'] else 'DRIFT ') + entry['path']
                  + f'\n  expected {entry["expectedSha256"]} ({entry["expectedBytes"]} bytes)'
                  + f'\n  rebuilt  {entry["actualSha256"]} ({entry["actualBytes"]} bytes)')
    results.append(entry)

generated_paths = {p.relative_to(mini).as_posix() for p in (mini / 'dev/groundsky/masters').rglob('*.png')}
extra = sorted(generated_paths - {e['path'] for e in expected})
generator_changes = []
for entry in sources:
    entry['sourceStillMatchesSnapshot'] = digest(ROOT / entry['path']) == entry['sha256']
    if not entry['sourceStillMatchesSnapshot']:
        generator_changes.append(entry['path'])
ok = not (failure or missing or drift or extra or original_changes or generator_changes) and len(generated_paths) == 122
report = {
    'ok': ok, 'utc': now, 'scratchTree': str(scratch),
    'python': sys.version, 'dependencies': versions,
    'threadLimits': {key: env[key] for key in ['OMP_NUM_THREADS', 'OPENBLAS_NUM_THREADS', 'MKL_NUM_THREADS', 'NUMEXPR_NUM_THREADS']},
    'nice': os.getpriority(os.PRIO_PROCESS, 0), 'generatorSources': sources,
    'commands': commands, 'expectedCount': 122, 'generatedCount': len(generated_paths),
    'matchingCount': sum(r['matches'] for r in results),
    'expectedBytes': sum(r['expectedBytes'] for r in expected),
    'generatedBytes': sum(r.get('actualBytes', 0) for r in results),
    'missing': missing, 'drift': drift, 'extra': extra, 'originalChanges': original_changes,
    'generatorChanges': generator_changes, 'failure': failure,
    'elapsedSeconds': round(time.monotonic() - start, 3), 'files': results,
}
REPORT.write_text(json.dumps(report, indent=2) + '\n')
summary = {key: report[key] for key in ['ok', 'expectedCount', 'generatedCount', 'matchingCount', 'expectedBytes', 'generatedBytes', 'missing', 'drift', 'extra', 'originalChanges', 'generatorChanges', 'elapsedSeconds']}
write_log('\nFINAL\n' + json.dumps(summary, indent=2))
print(json.dumps(summary, indent=2), flush=True)
sys.exit(0 if ok else 1)
